# Copy to ../.env

# --- Where the relay listens on the host (free port in 7000-8000; change if taken)
UC_PORT=7410
# UC_BIND=127.0.0.1          # use when your reverse proxy runs on the same machine

UC_DOMAIN=uclip.gaiasentinel.online

# --- Email (confirmation + password reset). Create a key at https://resend.com and verify the sending domain.
UC_RESEND_API_KEY=
UC_MAIL_FROM="Universal Clipboard <no-reply@gaiasentinel.online>"
# Defaults to true when UC_RESEND_API_KEY is set
# UC_REQUIRE_VERIFIED_EMAIL=true

# --- Google sign-in (optional). Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorised redirect URI: https://uclip.gaiasentinel.online/api/v1/auth/google/callback
UC_GOOGLE_CLIENT_ID=
UC_GOOGLE_CLIENT_SECRET=

# --- Access control
# UC_SIGNUPS=open            # or "closed" to stop new accounts
# UC_INVITE_CODE=            # require this code to sign up
# UC_MAX_USERS=10000

# --- Retention / limits
# UC_TTL_HOURS=168
# UC_MAX_ITEMS=100
# UC_SESSION_TTL_DAYS=30
